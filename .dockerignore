# Dependencies and build output are produced inside the image.
node_modules
.next
out

# VCS + local tooling
.git
.gitignore
coverage
*.log
tsconfig.tsbuildinfo

# Agent tooling trees (not part of the app; .agents alone is ~49MB, half the
# build context, and COPY . . would otherwise drag it into the builder layer).
.agents
.hermes
skills-lock.json

# Local data (SQLite DB + legacy JSON) must never enter the image.
data
data-test
data.json
data.json.migrated
dogfood-output

# Secrets
.env
.env.*
!.env.example

# Docs and tests are not needed at runtime.
docs
tests
reference

# Docker metadata
Dockerfile*
docker-compose*.yml
.dockerignore
