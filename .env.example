# ModelHub configuration (copy to .env and fill in)

# REQUIRED to store site API keys: 32-byte master key for AES-256-GCM (base64 or hex).
# Validated when a site key is created/updated; without it that operation is refused.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MODELHUB_MASTER_KEY=

# REQUIRED on first run: password for the initial `admin` account.
# On first boot ModelHub creates the admin user with this password. If unset, a
# random password is generated (only a warning is logged; the value is NOT printed).
MODELHUB_ADMIN_PASSWORD=

# OPTIONAL: database backend (default: sqlite).
# SQLite file defaults to ./data/app.db; set MODELHUB_DATA_PATH to a directory or .db file.
# DATABASE_DRIVER=sqlite
# MODELHUB_DATA_PATH=/var/lib/modelhub
# For Postgres, set both values. DATABASE_URL is required for this driver.
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgres://modelhub:***@localhost:5432/modelhub

# OPTIONAL: custom admin console path (obscures the default /admin).
# Auth (MODELHUB_ADMIN_PASSWORD) is the real gate; this only hides the URL.
# BUILD-TIME variable: Next bakes rewrites during `next build`, so changing it
# requires a rebuild (Docker: `docker compose up --build -d`), not a restart.
# MODELHUB_ADMIN_PATH=/my-secret-console

# OPTIONAL: default auto-refresh interval in hours (default: 6)
# MODELHUB_REFRESH_INTERVAL_HOURS=6

# OPTIONAL: allow outbound fetches to loopback / private addresses.
# Off by default. Any logged-in user can trigger a server-side fetch through
# site import and provider refresh, so enabling this turns the app into an
# SSRF channel (internal port scanning, cloud metadata at 169.254.169.254).
# Turn it on only when this instance must probe a relay on your own LAN.
# MODELHUB_ALLOW_PRIVATE_FETCH=true

# OPTIONAL: upstream fetch tuning
# MODELHUB_FETCH_TIMEOUT_MS=15000
# MODELHUB_FETCH_RETRIES=2
# MODELHUB_REFRESH_CONCURRENCY=4

# OPTIONAL: log level (fatal|error|warn|info|debug|trace|silent)
# LOG_LEVEL=info

# OPTIONAL: set to 'production' in deployment
# NODE_ENV=production
